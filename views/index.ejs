<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="style.css">
    <title>All chats</title>
</head>
<body>
    <h1>All chats</h1>
    <% for (let chat of chatas) {%>
    <div class="chat">
        <p>From: <%= chat.from %></p>
        <div class="msg">
             <p><%= chat.message %></p>
             <form method="get" action="/chats/<%= chat._id %>/edit">
                <button class="edit">Edit</button>
             </form>
             <form method="post" action="/chats/<%= chat._id %>?_method=delete">
                <button class="edit">Delete</button>
             </form>
             
        </div>
       
        <p>Received by <%= chat.to %></p>
        <hr>
         <p><%= chat.created_at.toString().split(" ") [4] %></p>

        
        
    </div>
<%} %>
     
<br>
<form action="/chats/new" method="get">
   <button class="add-chat"> <a>Add new chat</a></button>
</form>


    
</body>
</html>

